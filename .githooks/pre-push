#!/usr/bin/env sh
# Change-scoped local CI gate: the same checks a hosted CI would run, before
# anything reaches the remote, scoped to what the push actually changes.
# Zero external dependency / cost.
#
# Classes (first match per file; union across the push):
#   public docs - public-facing living docs -> copy/link audit
#   prose       - other docs/**, *.md, LICENSE* -> no gates
#   operational - scripts/**, pytest.ini -> black, ruff, pytest
#   rust        - crates/**, Cargo.toml, Cargo.lock -> cargo fmt/clippy/test
#   anything else (this hook included) -> full gates, fail-safe
# A push with no reachable base (new branch, zero remote sha) runs full.
#
# GILBRETH_GATE_DRY_RUN=1 prints the classification and exits (hook tests).
# Enable for this clone with:  git config core.hooksPath .githooks
# Bypass once (emergencies only) with: git push --no-verify
set -e

need_full=0
need_rust=0
need_operational_python=0
need_public_copy=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;; # deleting a remote ref: nothing outgoing
    esac
    case "$remote_sha" in
        *[!0]*) range="$remote_sha..$local_sha" ;;
        *)
            echo "[gate] new ref (no base to diff) - running the full gate"
            need_full=1
            break
            ;;
    esac
    files=$(git diff --name-only "$range" 2>/dev/null) || {
        echo "[gate] cannot diff $range (shallow/unknown base) - running the full gate"
        need_full=1
        break
    }
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        case "$f" in
            README.md | SECURITY.md | \
            docs/MAINTAINING.md | docs/RELEASE_PROCESS.md | \
            docs/VERIFY.md | docs/ARCHITECTURE.md | \
            docs/CAPABILITY_MATRIX.md)
                need_public_copy=1
                ;;
            docs/* | *.md | LICENSE*) ;;
            scripts/* | pytest.ini) need_operational_python=1 ;;
            crates/gilbreth-core/src/copy_style.rs)
                need_rust=1
                need_public_copy=1
                ;;
            crates/* | Cargo.toml | Cargo.lock) need_rust=1 ;;
            *) need_full=1 ;;
        esac
    done <<EOF
$files
EOF
done

if [ "$need_full" -eq 1 ]; then
    need_rust=1
    need_operational_python=1
fi

if [ "${GILBRETH_GATE_DRY_RUN:-0}" = "1" ]; then
    echo "[gate] dry run: full=$need_full rust=$need_rust operational_python=$need_operational_python public_copy=$need_public_copy"
    exit 0
fi

if [ "$need_operational_python" -eq 0 ] && [ "$need_rust" -eq 0 ] && [ "$need_public_copy" -eq 0 ]; then
    echo "[gate] outgoing changes are prose only - no gates to run"
    exit 0
fi

# Resolve a Python that carries the gate tooling (pytest/black/ruff). Prefer an
# activated virtualenv, then the repository .venv where those deps live, then
# python3, then python. Bare `python` is no longer required: some maintainer
# machines expose only python3 and .venv/bin/python, and a plain python3 does
# not have the tooling installed.
if [ "$need_public_copy" -eq 1 ] || [ "$need_operational_python" -eq 1 ]; then
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
    # A candidate must actually RUN, not merely exist on PATH. Windows ships
    # App Execution Alias stubs for python/python3 that resolve fine under
    # `command -v` and then fail with "Python was not found", so probe each
    # candidate. Windows venvs put the interpreter under Scripts/, not bin/.
    PY=""
    for candidate in         "${VIRTUAL_ENV:+$VIRTUAL_ENV/bin/python}"         "${VIRTUAL_ENV:+$VIRTUAL_ENV/Scripts/python.exe}"         "$repo_root/.venv/bin/python"         "$repo_root/.venv/Scripts/python.exe"         python3 python
    do
        [ -n "$candidate" ] || continue
        if "$candidate" -c "" >/dev/null 2>&1; then
            PY="$candidate"
            break
        fi
    done
    if [ -z "$PY" ]; then
        echo "[gate] no working Python found; need python3 or a venv with pytest/black/ruff"
        exit 1
    fi
fi


if [ "$need_public_copy" -eq 1 ] && [ "$need_operational_python" -eq 0 ]; then
    echo "[gate] public-document copy/link audit"
    "$PY" -m pytest \
        scripts/tests/test_copy_style_public_docs.py \
        scripts/tests/test_living_document_links.py \
        -q
fi

if [ "$need_operational_python" -eq 1 ]; then
    echo "[gate] black"
    "$PY" -m black --check scripts
    echo "[gate] ruff"
    "$PY" -m ruff check scripts
    echo "[gate] pytest"
    "$PY" -m pytest scripts/tests -q
fi

if [ "$need_rust" -eq 1 ]; then
    echo "[gate] cargo fmt"
    cargo fmt --all --check
    echo "[gate] cargo clippy"
    cargo clippy --locked --workspace --all-targets -- -D warnings
    echo "[gate] cargo test"
    cargo test --locked --workspace
fi

echo "[gate] all gates passed"
